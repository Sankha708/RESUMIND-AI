# RESUMIND AI Backend Environment Configuration (Template)
# Copy to .env for local overrides (never commit .env)

APP_NAME="RESUMIND AI API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (SQLite local, PostgreSQL in production)
DATABASE_URL="sqlite+aiosqlite:///./resumind.db"

# Opaque random session token; only its SHA-256 hash is stored by the backend.
SESSION_COOKIE_NAME="resumind_session"
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# AI Model Configuration (Local Ollama via LLMProvider interface)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_GENERATE_TIMEOUT_SEC=120
