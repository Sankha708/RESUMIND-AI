# Copy to a protected deployment environment; replace every placeholder.
APP_NAME="RESUMIND AI API"
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Exact public frontend origin. HTTPS is required in production.
CORS_ORIGINS="https://app.example.com"

# PostgreSQL-compatible production database URL; use managed secret storage.
DATABASE_URL="postgresql+asyncpg://resumind:replace-me@db.example.com/resumind"

SESSION_COOKIE_NAME="resumind_session"
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_SECONDS=3600

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_UPLOAD_COUNT=5
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
RATE_LIMIT_AI_COUNT=10
RATE_LIMIT_AI_WINDOW_SECONDS=300

# Point to a private/self-hosted Ollama service. No cloud key is required.
OLLAMA_BASE_URL="http://ollama.internal:11434"
OLLAMA_MODEL="llama3.2"
